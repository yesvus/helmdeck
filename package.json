{
  "name": "@yesvus/helmdeck",
  "version": "0.12.0",
  "packageManager": "pnpm@12.7.0",
  "type": "module",
  "description": "A Next.js admin dashboard engine with generated resource views, dashboard tiles, and host-configurable auth and data adapters",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yesvus/helmdeck.git"
  },
  "homepage": "https://helmdeck.yesvus.com",
  "bugs": {
    "url": "https://github.com/yesvus/helmdeck/issues"
  },
  "keywords": [
    "admin",
    "dashboard",
    "nextjs",
    "react",
    "tailwindcss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./baseline": {
      "types": "./dist/baseline.d.ts",
      "default": "./dist/baseline.js"
    },
    "./theme.css": "./dist/theme/tokens.css",
    "./package.json": "./package.json",
    "./tenant-scope": {
      "types": "./dist/tenant-scope.d.ts",
      "default": "./dist/tenant-scope.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "ci": "./scripts/ci",
    "prebuild": "node scripts/version-source.mjs write",
    "build": "tsc -p tsconfig.build.json && cp src/theme/tokens.css dist/theme/tokens.css",
    "prepack": "pnpm build",
    "pretypecheck": "pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p fixtures",
    "version:check": "node scripts/release-version.mjs check",
    "surface:check": "node scripts/exported-surface.cli.mjs check",
    "surface:record": "node scripts/exported-surface.cli.mjs record",
    "version:sync": "node scripts/version-source.mjs write",
    "version:next": "node scripts/release-version.mjs next",
    "version:bump": "node scripts/release-version.mjs bump",
    "test:release": "node --test scripts/release-version.test.mjs scripts/exported-surface.test.mjs scripts/deploy-smoke.test.mjs scripts/node-floor.test.mjs",
    "test:modal-geometry": "node scripts/modal-geometry.test.mjs",
    "smoke": "node scripts/deploy-smoke.mjs",
    "test": "vitest run",
    "verify:layout": "bash scripts/verify-layout",
    "test:watch": "vitest",
    "lint": "eslint .",
    "node-floor:check": "node scripts/node-floor.mjs",
    "dev": "next dev fixtures",
    "build:fixtures": "pnpm build && next build fixtures",
    "typecheck:example": "node scripts/typecheck-example.mjs",
    "typecheck:template": "node scripts/typecheck-template.mjs"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-slot": "^1",
    "lucide-react": ">=0.400",
    "motion": "^13.4.3",
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@payloadcms/db-sqlite": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-slot": "^1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "graphql": "17.0.2",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.59",
    "motion": "^13.4.3",
    "next": "^16",
    "payload": "3.91.0",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0"
  }
}
