{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@yesvus/helmdeck": [
        "./src/index"
      ],
      "@yesvus/helmdeck/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}